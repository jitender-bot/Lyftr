# ==============================================================================
# Lyftr AI Chatbot Environment Variables
# ==============================================================================

# Comma-separated pool of at least 2 API keys.
# Key IDs are key_1, key_2, ... in this exact order.
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# LiteLLM Model name to use (e.g., gemini/gemini-2.0-flash, gpt-4o-mini, openrouter/...)
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite Database Location. In Docker, maps to the mounted volume at /data/app.db
# For local dev without Docker: sqlite:///./data/app.db
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS allowed origins for FastAPI
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Enables the X-Simulate-Failure header failover hook (must be true on deployed backend)
ENABLE_FAILURE_SIMULATION=true

# Optional: Default system prompt if not overridden per session
DEFAULT_SYSTEM_PROMPT=You are a helpful and concise AI assistant.

# Frontend backend target URL (used during build or local dev)
VITE_BACKEND_URL=http://localhost:8000
